# event-rms – Umgebungskonfiguration
# Wird normalerweise von setup.php erzeugt. Manuell: kopieren nach .env und anpassen.

APP_ENV=production
APP_DEBUG=false

# Öffentliche Adresse dieser Installation (ohne Schrägstrich am Ende), z.B. https://anlass.meinverein.ch
# Wird für Links in E-Mails verwendet (Passwort zurücksetzen). Der Installer trägt sie automatisch ein.
APP_URL=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=meinverein_events
DB_USER=meinverein_user
DB_PASS=

# Optional: Mailversand via SMTP (empfohlen). Ohne SMTP_HOST wird PHP mail() verwendet.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ssl (Port 465) oder tls (Port 587)
SMTP_SECURE=ssl

# Nur Entwicklung: Datenbank für Integrationstests (wird bei jedem Testlauf geleert!)
# TEST_DB_NAME=meinverein_events_test
