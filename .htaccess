# event-rms – Zugriffsschutz für Shared Hosting (Apache).
# Unter nginx wirkt diese Datei nicht; setup.php prüft das und warnt.

Options -Indexes

# Dotfiles (.env, .git, …) sperren
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Interne Verzeichnisse sperren
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|database|tests|tools|lang|templates|vendor)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# Markdown-/Konzeptdateien nicht ausliefern
<FilesMatch "\.(md|sql|lock)$">
    Require all denied
</FilesMatch>
